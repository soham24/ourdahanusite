NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AES-256-GCM master key for encrypting owner Razorpay secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LISTING_PAYMENT_ENCRYPTION_KEY=your_32_byte_base64_key

# Telegram notifications bot. Create one via @BotFather, set the webhook to
#   https://ourdahanu.in/api/telegram/webhook?secret=<TELEGRAM_WEBHOOK_SECRET>
# TELEGRAM_BOT_TOKEN is reused for both the admin alerts and the per-user DMs.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=OurDahanuBot
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string
