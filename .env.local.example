# ───────────────────────────────────────────────────────────────────────────
# OurDahanu environment variables. Copy to .env.local and fill in.
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser; keep all others secret.
# ───────────────────────────────────────────────────────────────────────────

# ─── Supabase (required) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key — privileged server-side writes (payments, admin). NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Site (required) ───────────────────────────────────────────────────────
# Local: http://localhost:3000 · Prod: https://ourdahanu.in
# In prod this is how the app detects it should scope auth cookies to .ourdahanu.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AES-256-GCM master key for encrypting owner Razorpay secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LISTING_PAYMENT_ENCRYPTION_KEY=your_32_byte_base64_key

# ─── Razorpay (required for payments) ──────────────────────────────────────
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RazorpayX account number used for seller payouts.
RAZORPAY_X_ACCOUNT_NUMBER=your_razorpayx_account_number

# Razorpay webhook signing secret. Required for the orphaned-payment
# safety net: if a buyer's browser dies after they're charged, Razorpay
# pings /api/razorpay/webhook so we still know the payment was captured.
#
# How to get this value:
#   1. Razorpay dashboard → Settings → Webhooks → Add new webhook
#   2. URL: https://ourdahanu.in/api/razorpay/webhook
#   3. Active events: payment.captured, order.paid
#   4. Set a long random secret in the "Secret" field
#   5. Paste the same secret here
RAZORPAY_WEBHOOK_SECRET=generate_a_long_random_string

# ─── Email (optional — Resend) ─────────────────────────────────────────────
# Newsletter welcome emails, etc. Omit to disable email sending.
RESEND_API_KEY=your_resend_api_key

# ─── Telegram notifications (optional) ─────────────────────────────────────
# Create a bot via @BotFather, set the webhook to
#   https://ourdahanu.in/api/telegram/webhook?secret=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=OurDahanuBot
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string
# Optional separate bot token for per-user DMs (falls back to TELEGRAM_BOT_TOKEN).
TELEGRAM_USER_BOT_TOKEN=your_optional_user_bot_token

# ─── WhatsApp notifications (optional — Meta Cloud API) ─────────────────────
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# ─── Cron + admin (optional) ───────────────────────────────────────────────
# Authorizes /api/cron/* — Vercel cron sends it as the Authorization header.
CRON_SECRET=generate_a_long_random_string
# Email that is granted admin on sign-in (bootstraps the first admin).
ADMIN_EMAIL=you@example.com
# Set to 1 for verbose ISR/cache logging during debugging.
ISR_DEBUG=

# ─── Analytics (optional — Google Analytics 4) ─────────────────────────────
# Measurement ID from GA4 → Admin → Data Streams → your web stream.
# Leave unset locally — only set this in Vercel's PRODUCTION environment so
# dev/preview traffic doesn't pollute real analytics data.
NEXT_PUBLIC_GA_ID=
