{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/listing-expiry",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}
