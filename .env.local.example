# Copy this to .env.local and fill in your own values.
#
# Never paste a real value into THIS file: it is tracked by git, so anything
# written here becomes public and stays in the history even after it is
# edited out.
#
# Only the first block is required. Every optional value below is left
# EMPTY on purpose: the code treats "set to anything" as "configured", so a
# placeholder would switch a feature on and then fail at runtime. Leave a
# feature's lines empty until you have real credentials for it.
#
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser; keep all others secret.
# For the secrets marked "random", generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# ─── Required ──────────────────────────────────────────────────────────────
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key: server-side writes (payments, admin, notifications).
# NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# This deployment's own origin. Local: http://localhost:3000. In production,
# your domain (https://yourtown.in) -- auth cookies are scoped to it so
# sign-in carries across business subdomains.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin (recommended) ───────────────────────────────────────────────────
# The account that signs in with this email is made admin -- how the first
# admin is created.
ADMIN_EMAIL=

# ─── Payments (optional — Razorpay) ────────────────────────────────────────
# Without these, paid checkout is off; free listings (a 100% coupon, or a
# listing price of 0) and free bookings still work.
# Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (random). Razorpay calls the webhook if a buyer's
# browser dies after they paid, so the payment is still recorded.
#   Razorpay → Settings → Webhooks → Add new webhook
#   URL: https://<your domain>/api/razorpay/webhook
#   Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=
# 32-byte key (base64) that encrypts each business's own Razorpay secret at
# rest, for businesses that take payments into their own account:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LISTING_PAYMENT_ENCRYPTION_KEY=

# ─── Email (optional — Resend) ─────────────────────────────────────────────
# Newsletter and notification emails. Empty = no email is sent.
RESEND_API_KEY=

# ─── Telegram (optional) ───────────────────────────────────────────────────
# Create YOUR OWN bot with @BotFather. TELEGRAM_WEBHOOK_SECRET (random) is
# required if you use Telegram at all: the webhook refuses every request
# while it is unset. Register the webhook with the secret in the URL:
#   https://<your domain>/api/telegram/webhook?secret=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
# Your bot's username, without the @. "Connect Telegram" links point here.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Optional separate bot for per-user DMs (falls back to TELEGRAM_BOT_TOKEN).
TELEGRAM_USER_BOT_TOKEN=

# ─── WhatsApp (optional — Meta Cloud API) ──────────────────────────────────
# Also needs three message templates approved by Meta, with the exact names
# listed at the top of src/lib/whatsapp.ts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Cron (optional) ───────────────────────────────────────────────────────
# Authorizes /api/cron/* (random). Vercel cron sends it as the
# Authorization header; the routes refuse every request while it is unset.
CRON_SECRET=

# ─── Analytics and ads (optional) ──────────────────────────────────────────
# Set these only in Vercel's PRODUCTION environment, so local and preview
# traffic stays out of your real numbers.
# Google Analytics 4 measurement ID (G-XXXXXXX).
NEXT_PUBLIC_GA_ID=
# Google AdSense publisher ID (ca-pub-XXXXXXX).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ─── Debugging ─────────────────────────────────────────────────────────────
# 1 = verbose cache logging.
ISR_DEBUG=
